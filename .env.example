# Same base as gng-dashboard
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_HARVESTS_TABLE_NAME=Harvests

# Optional: full Airtable formula for which harvest is "current" on the thanks page.
# Default: OR({Status} = 'Publish', {Status} = 'Published')
# AIRTABLE_CURRENT_HARVEST_FILTER=

# Optional: comma-separated origins allowed for CORS (e.g. https://yoursite.com,https://www.yoursite.com).
# If unset, responses use Access-Control-Allow-Origin: *
# PUBLIC_ALLOWED_ORIGINS=
