# Same base as gng-dashboard
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_HARVESTS_TABLE_NAME=Harvests
# Optional: must match API field name for the harvest title (same as gng-dashboard). Default: Harvest Name
# AIRTABLE_HARVEST_NAME_FIELD=

# Optional: full Airtable formula for which harvest is "current" on the thanks page.
# Default: {Status} = 'Sent'
# AIRTABLE_CURRENT_HARVEST_FILTER=

# Embed page: cache Airtable reads for this many seconds (5–300). Faster repeat loads; default 45.
# EMBED_CACHE_SECONDS=45
